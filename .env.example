# Copy to .env.local and fill in once these accounts exist.
# Nothing here is required for `npm run dev` — email sending just
# silently no-ops (with a console warning) until it's configured.

# Resend (https://resend.com) — transactional email for order
# confirmation + owner notification.
RESEND_API_KEY=
# Must be a verified sending domain in Resend, e.g. "Floréa <orders@yourdomain.com>"
RESEND_FROM_EMAIL=
# Where new-order notifications are sent (you, the owner).
OWNER_NOTIFICATION_EMAIL=

# The deployed site's own URL, e.g. https://florea.com — used to build
# an absolute logo URL for emails (email clients can't load relative
# paths). Leave unset while only running locally.
NEXT_PUBLIC_SITE_URL=
